site_name: RSRF
site_description: Canonical spectral response definitions, ingest tooling, and QA workflows for optical satellite sensors.
site_url: https://marcyin.github.io/spectral_response/
repo_url: https://github.com/MarcYin/spectral_response
repo_name: MarcYin/spectral_response
site_dir: site
strict: true
exclude_docs: |
  decisions/README.md
  sensor-notes/README.md

theme:
  name: material
  features:
    - navigation.sections
    - navigation.expand
    - content.code.copy

markdown_extensions:
  - admonition
  - tables
  - toc:
      permalink: true
  - pymdownx.details
  - pymdownx.superfences

extra_css:
  - assets/stylesheets/__RSRF_VISUALIZATION_CSS_BUNDLE__

extra_javascript:
  - https://cdn.plot.ly/plotly-2.35.2.min.js
  - assets/javascripts/__RSRF_VISUALIZATION_JS_BUNDLE__

nav:
  - Home: index.md
  - Getting Started: getting-started.md
  - Visualizations: visualizations.md
  - Repository Layout: repository-layout.md
  - CLI: cli.md
  - Data Model: data-model.md
  - Development: development.md
  - Releasing: releasing.md
  - Sensor Notes:
      - Overview: sensor-notes/index.md
      - DESIS: sensor-notes/desis.md
      - PRISMA: sensor-notes/prisma.md
      - P2 Optical Bucket: sensor-notes/p2_optical_bucket.md
  - Decisions:
      - Overview: decisions/index.md
      - ADR-0001 Canonical Split: decisions/adr-0001-canonical-split.md
